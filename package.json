{
  "name": "luach",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p . && vite build",
    "build:single": "tsc -p . && vite build --mode single",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p .",
    "e2e": "playwright test",
    "oracle:zmanim": "java -cp tools/kosherjava/lib/zmanim-2.5.0.jar tools/kosherjava/Oracle.java > tests/zmanim-oracle.json",
    "horizons": "node tools/horizon/build-profiles.mjs",
    "sources:rambam": "node tools/sources/fetch-rambam.mjs",
    "review": "node -e \"process.env.REVIEW=1;require('child_process').execSync('npx playwright test e2e/review.spec.ts --project=desktop',{stdio:'inherit',env:process.env})\""
  },
  "dependencies": {
    "d3-geo": "^3.1.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "three": "^0.186.1",
    "topojson-client": "^3.1.0",
    "world-atlas": "^2.0.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/d3-geo": "^3.1.1",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@types/topojson-client": "^3.1.5",
    "@vitejs/plugin-react": "^6.1.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "vite-plugin-singlefile": "^2.3.3",
    "vitest": "^5.0.3"
  }
}
